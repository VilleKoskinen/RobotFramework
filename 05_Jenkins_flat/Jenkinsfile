// Reconstructed pipeline. Configure a dedicated Windows hardware agent first.
pipeline {
    agent { label 'pico-w-windows' }
    options { disableConcurrentBuilds() }
    stages {
        stage('Build') {
            steps {
                bat 'docker compose -p pico-ex05-build -f docker-compose.yml up --build --abort-on-container-exit --exit-code-from pico'
            }
            post {
                always { bat 'docker compose -p pico-ex05-build -f docker-compose.yml down' }
            }
        }
        stage('Program Pico W') {
            steps {
                bat 'if not exist "firmware/atcmd/build-docker/atcmd.elf" exit /b 2'
                bat 'openocd -f interface/cmsis-dap.cfg -f target/rp2040.cfg -c "adapter speed 1000" -c "program firmware/atcmd/build-docker/atcmd.elf verify reset exit"'
            }
        }
        stage('Robot tests') {
            steps {
                bat 'robot --outputdir results/05 03_Setup_and_teardown_and_resources/atcmd.robot'
            }
            post {
                always {
                    archiveArtifacts artifacts: 'results/05/**', allowEmptyArchive: true
                }
            }
        }
    }
}
